<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="floral-github" fetch="https://github.com/" />

  <!-- Replace an existing Coral checkout without affecting other devices. -->
  <remove-project path="device/google/coral" optional="true" />
  <remove-project path="vendor/google/coral" optional="true" />
  <remove-project path="kernel/google/msm-4.14" optional="true" />
  <remove-project path="packages/apps/ElmyraService" optional="true" />
  <remove-project path="vendor/lunaris/dolby" optional="true" />
  <remove-project path="vendor/hecker/floral/motionsense" optional="true" />
  <remove-project path="vendor/hecker/floral/faceid" optional="true" />

  <project name="its-hecker/pixelos_android_device_google_coral"
           path="device/google/coral" remote="floral-github" revision="main" />
  <project name="its-hecker/pixelos_proprietary_vendor_google_coral"
           path="vendor/google/coral" remote="floral-github" revision="main" />

  <!-- cnb was renamed to cnb-Latest-stable. Preserve its KernelSU submodule. -->
  <project name="its-hecker/infinity_cnb_kernel_google_msm-4.14"
           path="kernel/google/msm-4.14" remote="floral-github"
           revision="aaaa03e40200825133d21402cad8f2a86939a778"
           upstream="refs/heads/cnb-Latest-stable" dest-branch="cnb-Latest-stable"
           sync-s="true" />


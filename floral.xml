           revision="baab2beb7165caef27b4ee235641775e9d189acc"
           upstream="refs/heads/lineage-24.0" />
  <project name="its-hecker/vendor_lunaris_dolby"
           path="vendor/lunaris/dolby" remote="floral-github"
           revision="cf47b5151a63ecf3f11b124c252f29217b77356b"
           upstream="refs/heads/main" />

  <!-- Test the standalone plugins, with their own immutable prebuilt locks. -->
  <project name="its-hecker/floral-motionsense-plugin"
           path="vendor/hecker/floral/motionsense" remote="floral-github"
           revision="75c8e5ffb2f33c9d1e0ea19b51307a35baf058b5"
           upstream="refs/heads/main" dest-branch="main" />
  <project name="its-hecker/floral-3D-faceid-plugin"
